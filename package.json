{
  "name": "vite-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run test:unit && npm run build -- --outDir .check-dist.local",
    "test:browsers": "playwright test --project=desktop-firefox --project=desktop-webkit --project=mobile-webkit",
    "test:visual": "playwright test visual.spec.js --project=desktop-chromium --project=mobile-chromium",
    "verify:clean": "node scripts/verify-clean-install.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:chromium": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:smoke": "playwright test smoke.spec.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:static": "node scripts/check-static-host.mjs",
    "baseline:capture": "node scripts/capture-baseline.mjs",
    "baseline:lighthouse": "node scripts/lighthouse-baseline.mjs"
  },
  "dependencies": {
    "three": "0.147.0",
    "vue": "^3.5.43",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "vite": "^8.3.0"
  }
}
